# ---------------------------------------------------------------
# OrderIt API configuration. Copy to server/.env (npm run setup does this).
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1

# Front-end origins (used for CORS + links in e-mails)
CLIENT_PORT=5173
ADMIN_PORT=5174
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# MongoDB - local (default) or Atlas (mongodb+srv://user:pass@cluster.mongodb.net/shopverse)
MONGO_URI=mongodb://127.0.0.1:27017/shopverse

# JWT - CHANGE THESE to long random strings (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies - for production on different domains use COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Pricing
TAX_RATE=0.18
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=49
LOW_STOCK_THRESHOLD=10

# Cloudinary (optional - uploads are stored in server/uploads when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_SIZE_MB=2

# SMTP (optional - e-mails are printed to the console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OrderIt <no-reply@orderit.local>"

# Razorpay test mode (optional - payment simulation is used when empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret used to sign simulated payments when Razorpay keys are not set
PAYMENT_SIMULATION_SECRET=change-me-simulation-secret

# Anthropic (optional - rule-based assistant is used when empty). Never expose to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Product images: "dataset" (dataset URLs, local/educational use) or "licensed"
# ("licensed" swaps in URLs from server/seed/data/licensed-images.json before public deployment)
IMAGE_SOURCE=dataset

# Logging: dev | combined | none
LOG_FORMAT=dev
