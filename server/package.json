{
  "name": "orderit-server",
  "version": "1.0.0",
  "author": "Sai Pavan (https://github.com/Saipavanavsp)",
  "license": "UNLICENSED",
  "private": true,
  "description": "OrderIt REST API (Express + MongoDB)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch-path=./config --watch-path=./controllers --watch-path=./docs --watch-path=./middleware --watch-path=./models --watch-path=./routes --watch-path=./services --watch-path=./utils --watch-path=./validators --watch-path=./app.js --watch-path=./server.js --watch-preserve-output server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --no-warnings=ExperimentalWarning\" jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --no-warnings=ExperimentalWarning\" jest --runInBand --coverage",
    "seed": "node seed/seedData.js",
    "seed:destroy": "node seed/seedData.js --destroy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "razorpay": "^2.9.8",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
